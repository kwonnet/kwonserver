<mjml>
 <mj-head><mj-title>Kwonnet account security</mj-title><mj-preview>{{description}}</mj-preview>
 <mj-attributes><mj-all font-family="Arial, Helvetica, sans-serif"/><mj-text color="#263446" font-size="16px" line-height="26px"/><mj-button background-color="#0084C7" color="#ffffff" font-weight="bold" border-radius="8px" padding="16px 24px"/></mj-attributes></mj-head>
 <mj-body background-color="#eef4f8" width="600px">
 <mj-section padding="32px 24px 16px"><mj-column><mj-image src="{{logoUrl}}" alt="Kwonnet" width="64px" href="{{appUrl}}"/><mj-text align="center" font-size="24px" font-weight="bold" color="#0084C7">Kwonnet</mj-text></mj-column></mj-section>
 <mj-wrapper background-color="#ffffff" border-radius="16px" padding="16px">
 <mj-section padding="12px"><mj-column>
 <mj-text font-size="28px" line-height="36px" font-weight="bold">{{title}}</mj-text>
 <mj-text>Hi {{name}},</mj-text><mj-text>{{description}}</mj-text>
 <mj-button href="{{actionUrl}}">{{button}}</mj-button>
 <mj-text font-size="13px" color="#62748a">{{expiry}}</mj-text>
 <mj-divider border-color="#e3edf3"/>
 <mj-text font-size="13px" color="#62748a">Button not working? Copy this link into your browser:<br/><a href="{{actionUrl}}" style="color:#0084C7;word-break:break-all">{{actionUrl}}</a></mj-text>
 </mj-column></mj-section></mj-wrapper>
 <mj-section padding="16px 24px 32px"><mj-column><mj-text align="center" font-size="12px" color="#62748a">Kwonnet - Connecting the dots and nodes<br/><a href="{{appUrl}}/privacy-policy" style="color:#0084C7">Privacy policy</a></mj-text></mj-column></mj-section>
 </mj-body>
</mjml>
