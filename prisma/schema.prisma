// Durable operation receipts. Never expire while requests can be replayed.
model WalletOperation {
  id          String   @id
  scope       String
  fingerprint String
  result      Json
  createdAt   DateTime @default(now())
}

// A charge and its pending game action commit together. Redis delivery is retryable.
model GameWalletAction {
  id             String   @id
  userId         String
  roomId         String
  roundId        String?
  kind           String
  payload        Json
  deductedCoins  Decimal  @db.Decimal(20, 2)
  deductedBonus  Decimal  @db.Decimal(20, 2)
  status         String   @default("PENDING")
  reason         String?
  createdAt      DateTime @default(now())
  settledAt      DateTime?
  @@index([status, createdAt])
}

// Deployment-owned cursor; not application data or a writable public model.
model KwonnetAnalyticsSetup {
  name        String    @id
  cursor      String?
  completedAt DateTime? @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6)
  @@ignore
}


enum AuthProvider {
  PASSWORD
  GOOGLE
  LEGACY
}

model AuthIdentity {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AuthProvider
  providerAccountId String
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  sessions UserSession[]
  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model UserSession {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityId String?
  identity AuthIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  provider AuthProvider
  device Json
  location Json?
  ipAddress String?
  ipHash String?
  metadataSource String
  createdAt DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedReason String?
  retainUntil DateTime
  events LoginEvent[]
  pushSubscriptions PushNotification[]
  @@index([userId, revokedAt, expiresAt])
  @@index([retainUntil])
}

model LoginEvent {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  provider AuthProvider
  kind String
  device Json
  location Json?
  ipAddress String?
  ipHash String?
  metadataSource String
  createdAt DateTime @default(now())
  retainUntil DateTime
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([sessionId])
  @@index([retainUntil])
}
