// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions", "relationJoins"]
  binaryTargets = ["native", "darwin-arm64"]
  // output   = "../src/generated/client"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  passwordChangedAt DateTime?
  authIdentities AuthIdentity[]
  authSessions UserSession[]
  loginEvents LoginEvent[]
  id                    String             @id @default(cuid())
  name                  String
  username              String             @unique
  email                 String             @unique
  bio                   String?
  avatar                String?
  banner                String?
  website               String?
  dateOfBirth           DateTime?          @db.Date
  dateOfBirthChangedAt  DateTime?
  countryChangedAt      DateTime?
  googleSubject         String?            @unique
  password              String?
  phone                 String?
  /// Historical account identifier retained in storage only.
  telId                 String? @ignore
  countryId             String? // References the Country model
  country               Country?           @relation(fields: [countryId], references: [id])
  role                  UserRoleEnum       @default(USER)
  status                UserStatus         @default(ACTIVE)
  userType              UserTypeEnum       @default(PERSONAL)
  isVerified            Boolean            @default(false) // Indicates if email is verified
  identityVerified      Boolean            @default(false) // Indicates if identity is verified
  accountVerified       Boolean            @default(false) // Indicates if account is verified for reaching a milestone like 1M followers and given badge
  accountVerifiedAt     DateTime?
  identityVerifiedAt    DateTime?
  verifiedAt            DateTime?
  /// [UserMeta]
  meta                  Json?              @default("{\"type\": \"LEGACY\", \"status\": \"INACTIVE\", \"color\": \"blue\"}")
  metadata              Json[]             @default([])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  isPrivate             Boolean            @default(false)
  deactivatedAt         DateTime?
  deletedAt             DateTime?
  wallet                Wallet?
  userTaskSettings      UserTaskSettings?
  location              UserLocation?
  creatorGames          Game[]
  creatorGameRooms      GameRoom[]
  creatorCategories     GameCategory[]
  creatorCoinPackages   CoinPackage[]
  creatorTipPackages    TipPackage[]
  creatorTasks          Task[]
  performedTasks        UserTask[]
  creatorGameMilestones GameMilestone[]
  gameYearStats         GameYearStat[]
  gameMonthStats        GameMonthStat[]
  gameAchievements      GameAchievement[]
  gameEnergies          GameEnergy[]
  revenues              Revenue[]
  transactions          Transaction[]
  transactionsSent      Transaction[]      @relation("Sender")
  transactionsReceived  Transaction[]      @relation("Recipient")
  notifications         Notification[]     @relation("NotificationsReceived")
  sentNotifications     Notification[]     @relation("NotificationsSent")
  postTipsReceived      PostTip[]          @relation("PostTipsReceived")
  postTipsSent          PostTip[]          @relation("PostTipsSent")
  walletAddress         WalletAddress[] @ignore
  cryptoAddreses        CryptoAddress[] @ignore
  referralsSent         Referral[]         @relation("ReferralsSent") // Referrals this user initiated
  referralsReceived     Referral[]         @relation("ReferralsReceived") // Referrals this user received
  subscriptions         Subscription[]
  transactionLogs       TransactionLogs[]
  tips                  RewardTip[]
  posts                 Post[]             @relation("PostAuthor")
  // scheduledPosts        Post[]             @relation("ScheduledPosts")
  postMentions          PostMention[]
  postUserTags          PostUserTag[]
  postVotes             PollVoter[]
  likedPosts            LikedPost[]
  bookmarks             Bookmark[]
  followers             Follow[]           @relation("Following")
  following             Follow[]           @relation("Follower")
  blockedUsers          BlockUser[]        @relation("Blocker")
  blockedBy             BlockUser[]        @relation("Blocked")
  mutedUsers            MuteUser[]         @relation("Muter")
  mutedBy               MuteUser[]         @relation("Muted")
  stories               Story[]
  storyViewed           StoryViewer[]
  storyMention          StoryMention[]
  storyReactions        StoryReaction[]
  pushNotifications     PushNotification[]
  participants          QuizParticipant[]
  winners               QuizReward[]
  followerHistory       FollowHistory[]    @relation("HistoryFollowing")
  followingHistory      FollowHistory[]    @relation("HistoryFollower")

  blockerHistory BlockHistory[] @relation("HistoryBlocked")
  blockedHistory BlockHistory[] @relation("HistoryBlocker")

  muterHistory MuteHistory[] @relation("HistoryMuted")
  mutedHistory MuteHistory[] @relation("HistoryMuter")

  postReports PostReport[]

  reportedUsers UserReport[] @relation("Reporter")
  reportedBy    UserReport[] @relation("Reported")

  disinterestPosts PostDisinterest[]
  pinPosts         PostPin[]
  highlightPosts   PostHighlight[]
  historyPosts     PostHistory[]
  impressionPosts  PostImpression[]
  viewPosts        PostView[]
  clickPosts       PostClick[]
  profileVisits    ProfileVisit[]    @relation("Visitor")
  profileVisitors  ProfileVisit[]
  mediaPostLogs    PostMediaLog[]
  convoDevices     ConvoDevice[]   
  convoMemberships ConvoMembership[]
  convoMessages    ConvoMessage[]
  sharePosts       PostShare[]

  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([username])
  @@index([createdAt])
}

model ConvoDevice {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  // E2E keys — public material only
  identityKeyPub    Bytes    // Curve25519 public key
  signedPrekeyPub   Bytes
  oneTimePrekeys    OneTimePrekey[]
  meta              Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model OneTimePrekey {
  id         String       @id @default(cuid())
  deviceId   String
  device     ConvoDevice  @relation(fields: [deviceId], references: [id])
  keyPub     Bytes
  consumed   Boolean      @default(false)
  createdAt  DateTime     @default(now())
}

model Conversation {
  id            String        @id @default(cuid())
  // one-on-one only in this starter
  memberships   ConvoMembership[]
  messages      ConvoMessage[]
  callLogs      CallLog[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ConvoMembership {
  id              String        @id @default(cuid())

  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id])

  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id])
  // Stores encrypted shared secret material sealed to device keys if you want multi-device support
  // For simple single-device use, derive per-message keys from a root via a ratchet and do not store here.
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ConvoMessage {
  id              String        @id @default(cuid())
  // ciphertext & metadata
  cipherText      Bytes
  nonce           Bytes
  // optional additional data (JSON) e.g., mime type, file ref, thumbnails – encrypted separately if sensitive
  metaEnc         Bytes?
  // plaintext preview/safety not stored — keep server blind
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id])

  senderId        String
  sender          User          @relation(fields: [senderId], references: [id])

  attachments     Attachment[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

}

model Attachment {
  id         String        @id @default(cuid())
  messageId  String
  message    ConvoMessage  @relation(fields: [messageId], references: [id])
  // store blobs externally, server holds only opaque IDs/paths
  storageKey String   // e.g., S3 key or file path
  cipherKey  Bytes    // encrypted file key (sealed to recipient devices)
  mimeType   String
  size       Int

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CallLog {
  id              String       @id @default(cuid())
  callerId        String
  calleeId        String
  startedAt       DateTime     @default(now())
  endedAt         DateTime?
  status          CallStatus
  
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum CallStatus {
  RINGING
  CONNECTED
  ENDED
  MISSED
}

model ProfileVisit {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  visitorId String? // Optional for anonymous
  visitor   User?    @relation("Visitor", fields: [visitorId], references: [id])
  sessionId String?
  device    Json?
  meta      Json?
  referer   String?
  createdAt DateTime @default(now())

  @@index([createdAt])

}

model UserReport {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  reason     ReportReason
  message    String?
  meta       Json?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter     User @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser User @relation("Reported", fields: [reportedId], references: [id])

  @@index([createdAt])

}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(ACCEPTED) // NEW ENUM
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  follower    User @relation("Follower", fields: [followerId], references: [id])
  following   User @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([createdAt])

}

model FollowHistory {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  action      FollowAction
  isPrivate   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  follower  User @relation("HistoryFollower", fields: [followerId], references: [id])
  following User @relation("HistoryFollowing", fields: [followingId], references: [id])

  @@index([createdAt])

}

model BlockUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])

  @@index([createdAt])

}

model BlockHistory {
  id        String      @id @default(cuid())
  blockerId String
  blockedId String
  action    BlockAction
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  blocker User @relation("HistoryBlocker", fields: [blockerId], references: [id])
  blocked User @relation("HistoryBlocked", fields: [blockedId], references: [id])

  @@index([createdAt])

}

model MuteUser {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  muter User @relation("Muter", fields: [muterId], references: [id])
  muted User @relation("Muted", fields: [mutedId], references: [id])

  @@unique([muterId, mutedId])
  @@index([createdAt])

}

model MuteHistory {
  id        String     @id @default(cuid())
  muterId   String
  mutedId   String
  action    MuteAction
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  muter User @relation("HistoryMuter", fields: [muterId], references: [id])
  muted User @relation("HistoryMuted", fields: [mutedId], references: [id])

  @@index([createdAt])

}

model UserLocation {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])

}

model Story {
  id         String          @id @default(cuid())
  user       User            @relation(fields: [userId], references: [id])
  userId     String
  contentUrl String // image or video
  type       StoryType       @default(IMAGE)
  createdAt  DateTime        @default(now())
  expiresAt  DateTime // e.g., now() + 24h
  viewers    StoryViewer[]
  mentions   StoryMention[]
  reactions  StoryReaction[]

  @@index([createdAt])

}

model StoryViewer {
  id       String   @id @default(cuid())
  story    Story    @relation(fields: [storyId], references: [id])
  storyId  String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  viewedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([storyId, userId]) // ensure a user only appears once per story
  @@index([createdAt])
  @@index([viewedAt])

}

model StoryMention {
  id       String   @id @default(cuid())
  story    Story    @relation(fields: [storyId], references: [id])
  storyId  String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  viewedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([storyId, userId]) // ensure a user only appears once per story
  @@index([createdAt])
}

model StoryReaction {
  id       String   @id @default(cuid())
  story    Story    @relation(fields: [storyId], references: [id])
  storyId  String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  viewedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([storyId, userId]) // ensure a user only appears once per story
   @@index([createdAt])
}

enum StoryType {
  IMAGE
  VIDEO
  TEXT
}

model Post {
  topicModel String?
  scheduledEffectsPending Boolean @default(false)
  id               String        @id @default(cuid())
  content          String?
  scheduleAt       DateTime?
  location         String?
  topic            String?
  status           PostStatus    @default(PUBLISHED)
  type             PostTypeEnum
  kind             PostKindEnum
  scope            PostScopeEnum @default(ANYONE)
  totalViews       BigInt        @default(0)
  totalLikes       BigInt        @default(0)
  totalReplies     BigInt        @default(0)
  totalShares      BigInt        @default(0)
  totalBookmarks   BigInt        @default(0)
  totalReposts     BigInt        @default(0)
  totalQuotes      BigInt        @default(0)
  totalImpressions BigInt        @default(0)
  totalTips        BigInt        @default(0)
  media            PostMedia[] // Relation to associated media
  isHidden         Boolean       @default(false) // <--- Add this
  parentId         String? // Links to parent post if this is a child
  parent           Post?         @relation("PostParent", fields: [parentId], references: [id])
  // Replies are direct children of a post (can be root or thread)
  replies          Post[]        @relation("PostParent")
  // Thread posts are like children under the root
  thread           Post[]        @relation("PostRoot")
  root             Post?         @relation("PostRoot", fields: [rootId], references: [id])
  rootId           String?


  userId        String
  user          User              @relation("PostAuthor", fields: [userId], references: [id])
  countryId     String? // References the Country model
  country       Country?          @relation(fields: [countryId], references: [id])
  meta          Json?
  poll          Poll?
  quiz          Quiz?
  mentions      PostMention[]
  tagUsers      PostUserTag[]
  hashTags      PostHashTag[]
  topics        PostTopic[] // Relation to extracted keywords
  likes         LikedPost[]
  bookmarks     Bookmark[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  transactions  Transaction[]
  notifications Notification[]
  reports       PostReport[]
  disinterest   PostDisinterest[]
  pins          PostPin[]
  highlights    PostHighlight[]
  history       PostHistory[]
  impressions   PostImpression[]
  views         PostView[]
  clicks        PostClick[]
  profileVisits ProfileVisit[]
  mediaLogs     PostMediaLog[]
  tips          PostTip[]
  shares        PostShare[]
  replyCountries PostReplyCountry[]
  replyContinents PostReplyContinent[]

  @@index([userId, createdAt, kind, status])
  @@index([userId, status, createdAt(sort: Desc), id(sort: Desc)], map: "Post_profile_feed_idx")
  @@index([createdAt])
}

model PostTrendingEvent {
  postId     String
  authorId   String    // ← Required for unique users
  keyword    String
  createdAt  DateTime  @db.Timestamptz(6)
  countryId  String?
  isHashtag  Boolean   @default(false)

  @@index([postId])
  @@id([postId, keyword, createdAt])
  @@index([createdAt])
  @@index([keyword, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([countryId, createdAt(sort: Desc)])
}

model PostReplyCountry {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  countryId String // Links to Country
  country   Country  @relation(fields: [countryId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model PostReplyContinent {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id])
  continentId String // Links to Continent
  continent   Continent @relation(fields: [continentId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

   @@index([createdAt])
}

model PostClick {
  id        String           @id @default(cuid())
  postId    String
  userId    String? // optional for anonymous/guest users
  sessionId String? // useful for anonymous tracking
  source    PostMetricSource // e.g., 'home_feed', 'search_results', 'profile'
  action    PostMetricAction
  timestamp DateTime // Time impression occurred (from client)
  referer   String?
  meta      Json?
  device    Json?
  createdAt DateTime         @default(now())

  post Post  @relation(fields: [postId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([postId, userId])
  @@index([userId, postId])
  @@index([userId, createdAt])
  @@index([userId, timestamp])
   @@index([createdAt])
}

model PostImpression {
  id        String   @id @default(cuid())
  postId    String
  sessionId String?
  userId    String? // Optional if you want anonymous impressions
  meta      Json?
  device    Json?
  timestamp DateTime // Time impression occurred (from client)
  referer   String?
  createdAt DateTime @default(now()) // Time it's stored

  post Post  @relation(fields: [postId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([postId, userId])
  @@index([userId, postId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
  @@index([userId, timestamp])
  @@index([postId, timestamp])
   @@index([createdAt])
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  sessionId String?
  userId    String? // Optional if you want anonymous impressions
  meta      Json?
  device    Json?
  kind      String?
  timestamp DateTime // Time impression occurred (from client)
  referer   String?
  createdAt DateTime @default(now()) // Time it's stored

  post Post  @relation(fields: [postId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([postId, userId])
  @@index([userId, postId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
  @@index([userId, timestamp])
  @@index([postId, timestamp])
  @@index([createdAt])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  userId    String?
  sessionId String?
  meta      Json?
  device    Json?
  timestamp DateTime // Time impression occurred (from client)
  duration  Int // time spent viewing the post in secs
  referer   String?
  createdAt DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([postId, userId])
  @@index([userId, postId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
  @@index([userId, timestamp])
  @@index([postId, timestamp])
  @@index([createdAt])
}

model PostHistory {
  id        String     @id @default(cuid())
  postId    String // The post being deleted
  userId    String // The user who performed the action
  action    PostAction
  reason    String? // Reason for deletion
  createdAt DateTime   @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

   @@index([createdAt])
}

model PostPin {
  id          String      @id @default(cuid())
  postId      String
  post        Post        @relation(fields: [postId], references: [id])
  userId      String // who pinned it
  user        User        @relation(fields: [userId], references: [id])
  contextType PostContext @default(PROFILE) // Enum: GLOBAL, COMMUNITY, PROFILE
  contextId   String? // e.g., communityId if pinned in a community
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([postId, contextType, contextId])
   @@index([createdAt])
}

model PostHighlight {
  id          String      @id @default(cuid())
  postId      String
  post        Post        @relation(fields: [postId], references: [id])
  userId      String // who pinned it
  user        User        @relation(fields: [userId], references: [id])
  contextType PostContext @default(PROFILE) // Enum: GLOBAL, COMMUNITY, PROFILE
  contextId   String? // e.g., communityId if pinned in a community
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([postId, contextType, contextId])
   @@index([createdAt])
}

model PostDisinterest {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId]) //  One "not interested" record per user per post
   @@index([createdAt])
}

model PostReport {
  id        String       @id @default(cuid())
  userId    String
  postId    String
  reason    ReportReason // Enum for standard reasons
  message   String? // Optional extra description
  meta      Json? // Additional metadata
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  reporter User @relation(fields: [userId], references: [id])
  post     Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId]) // A user can't report the same post twice
   @@index([createdAt])
}

model Quiz {
  id           String            @id @default(cuid())
  postId       String            @unique
  post         Post              @relation(fields: [postId], references: [id])
  isPaid       Boolean           @default(false)
  rewardAmount Decimal @db.Decimal(20, 2) // total reward coins to be split
  expireAt     DateTime // quiz deadline
  maxWinners   Int
  scope        ScopeEnum         @default(NONE)
  countries    QuizCountry[]
  continents   QuizContinent[]
  options      QuizOption[]
  participants QuizParticipant[]
  winners      QuizReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   @@index([createdAt])
}

model QuizOption {
  id        String  @id @default(cuid())
  quizId    String
  text      String
  isCorrect Boolean @default(false)
  votes     Int     @default(0)
  quiz      Quiz    @relation(fields: [quizId], references: [id])

  participants QuizParticipant[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

   @@index([createdAt])

}

model QuizReward {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  amount    Decimal @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, quizId]) // ✅ one reward per quiz

   @@index([createdAt])
}

model QuizParticipant {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  quizId    String
  isCorrect Boolean
  optionId  String
  option    QuizOption @relation(fields: [optionId], references: [id])

  quiz Quiz @relation(fields: [quizId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, quizId])

  @@index([userId, createdAt])

   @@index([createdAt])
}

model QuizCountry {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  countryId String // Links to Country
  country   Country  @relation(fields: [countryId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   @@index([createdAt])
}

model QuizContinent {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  continentId String // Links to Continent
  continent   Continent @relation(fields: [continentId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

   @@index([createdAt])
}

model Topic {
  id        String      @id @default(cuid())
  word      String      @unique
  count     Int         @default(0) // Tracks total occurrences across all posts
  posts     PostTopic[] // Relation to posts containing this keyword
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

   @@index([createdAt])
}

model PostTopic {
  id        String @id @default(cuid())
  postId    String
  keywordId String
  post      Post   @relation(fields: [postId], references: [id])
  keyword   Topic  @relation(fields: [keywordId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   @@index([createdAt])
}

model PostMedia {
  id             String         @id @default(cuid())
  postId         String
  post           Post           @relation(fields: [postId], references: [id])
  fileId         String // Unique identifier for the media file
  name           String
  url            String
  height         Int
  width          Int
  size           Int // File size in bytes
  thumbnailUrl   String?
  fileType       String // MIME type, e.g., image/jpeg, video/mp4
  filePath       String
  altText        String? // Optional alt text for accessibility
  flags          String[]       @default([]) // Metadata flags, e.g., "NSFW", "sensitive"
  meta           Json? // Additional metadata
  totalViews     BigInt         @default(0) // Analytics: Total views of this media
  totalDownloads BigInt         @default(0) // Analytics: Total downloads of this media
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  analytics      PostMediaLog[]

   @@index([createdAt])
}

model PostMediaLog {
  id              String          @id @default(cuid())
  action          PostMediaAction @default(VIEW) // view, watch, download
  kind            PostMediaKind
  duration        Float           @default(0)
  watchedPct      Float           @default(0)
  muted           Boolean         @default(true)
  playbackRate    Float           @default(0)
  sessionDuration Float           @default(0) // actual engaged watch time in seconds
  sessionId       String?
  device          Json?
  meta            Json?
  timestamp       DateTime
  referer         String?
  mediaId         String
  media           PostMedia       @relation(fields: [mediaId], references: [id])
  postId          String?
  post            Post?           @relation(fields: [postId], references: [id])
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  createdAt       DateTime        @default(now())

   @@index([createdAt])
}

model Poll {
  id          String          @id @default(cuid())
  isMultiVote Boolean         @default(false)
  expireAt    DateTime
  scope       ScopeEnum       @default(NONE)
  postId      String          @unique
  post        Post            @relation(fields: [postId], references: [id])
  countries   PollCountry[]
  continents  PollContinent[]
  options     PollOption[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

   @@index([createdAt])
}

model PollOption {
  id        String      @id @default(cuid())
  pollId    String
  poll      Poll        @relation(fields: [pollId], references: [id])
  text      String
  votes     BigInt      @default(0)
  voters    PollVoter[] // Track voters for this option
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

   @@index([createdAt])
}

model PollVoter {
  id        String     @id @default(cuid())
  userId    String // References the user who voted
  user      User       @relation(fields: [userId], references: [id])
  optionId  String // References the poll option voted for
  option    PollOption @relation(fields: [optionId], references: [id])
  votedAt   DateTime   @default(now())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, createdAt])

   @@index([createdAt])
}

model PollCountry {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id])
  countryId String // Links to Country
  country   Country  @relation(fields: [countryId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   @@index([createdAt])
}

model PollContinent {
  id          String    @id @default(cuid())
  pollId      String
  poll        Poll      @relation(fields: [pollId], references: [id])
  continentId String // Links to Continent
  continent   Continent @relation(fields: [continentId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

   @@index([createdAt])
}

model PostMention {
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([postId, userId])
  @@index([userId, createdAt])

   @@index([createdAt])
}

model PostUserTag {
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([postId, userId])
  @@index([userId, createdAt])

   @@index([createdAt])
}

model PostTag {
  id        String        @id @default(cuid())
  name      String        @unique
  posts     PostHashTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

   @@index([createdAt])
}

model PostHashTag {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  tag       PostTag  @relation(fields: [tagId], references: [id])
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, tagId]) // Ensure a tag is not associated with the same post multiple times

   @@index([createdAt])
}

model LikedPost {
  id        String   @id @default(cuid()) // Unique ID for LikedPost
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId]) // Prevents duplicate likes
  @@index([userId, createdAt])

   @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(cuid()) // Unique ID for LikedPost
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId]) // Prevents duplicate likes
  @@index([userId, createdAt])

   @@index([createdAt])
}

model Continent {
  id                  String          @id @default(cuid())
  code                String          @unique // 2-letter code (e.g., AF, AS, EU)
  name                String          @unique
  countries           Country[]
  pollContinents      PollContinent[]
  quizContinents      QuizContinent[]
  postReplyContinents PostReplyContinent[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([code])

  @@index([createdAt])
}

model Country {
  id                  String        @id @default(cuid())
  name                String        @unique
  iso2                String        @unique @db.Char(2) // 2-letter code (e.g., US, FR)
  iso3                String        @unique @db.Char(3) // 3-letter code (e.g., USA, FRA)
  emoji               String        @unique
  continent           Continent     @relation(fields: [continentId], references: [id])
  continentId         String
  users               User[]
  posts               Post[]
  pollCountries       PollCountry[]
  quizCountries       QuizCountry[]
  postReplyCountries  PostReplyCountry[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([iso2])
  @@index([iso3])
  @@index([continentId])

   @@index([createdAt])
}

model SubscriptionPlan {
  id            String         @id @default(cuid()) // Unique subscription plan ID
  name          String
  ngnPrice      Decimal @db.Decimal(20, 2) // Price in Nigerian Naira (NGN)
  price         Decimal @db.Decimal(20, 2) // Monthly base price
  discount      Float // Discount for yearly plans (e.g., 0.1 for 10% off)
  accountType   UserTypeEnum
  metadata      Json?
  /// [PlanTier]
  tier          Json[]         @default([])
  subscriptions Subscription[]
  features      PlanFeature[]
  transactions  Transaction[]
  createdAt     DateTime       @default(now()) // Timestamp when plan was created
  updatedAt     DateTime       @updatedAt // Timestamp of last plan update

   @@index([createdAt])
}

model PlanFeature {
  id     String           @id @default(cuid()) // Unique feature ID
  name   String
  /// [PlanFeature]        
  items  Json[]
  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
}

model Subscription {
  id           String           @id @default(cuid()) // Unique subscription ID
  userId       String // Foreign key for the user who subscribes
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId       String // Foreign key for the subscription plan
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  isPrimary    Boolean          @default(false)
  isRecurring  Boolean          @default(false)
  startDate    DateTime // Date the subscription started
  endDate      DateTime // Date the subscription ends (calculated)
  billingCycle BillingCycleEnum @default(MONTHLY) // monthly or yearly billing cycle
  status       SubStatusEnum    @default(ACTIVE)
  transactions Transaction[]
  meta         Json?
  metadata     Json[]           @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

   @@index([createdAt])
}

model Notification {
  id          String        @id @default(cuid())
  pushSentAt DateTime?
  pushAttempts Int @default(0)
  nextPushAttemptAt DateTime @default(now())
  title       String
  message     String
  meta        Json?
  type        NotifTypeEnum @default(NONE)
  action      NotifAction   @default(NONE)
  isSeen      Boolean?      @default(false)
  isRead      Boolean?      @default(false)
  senderId    String?
  sender      User?         @relation("NotificationsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?         @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  post        Post?         @relation(fields: [postId], references: [id])
  postId      String?
  createdAt   DateTime?     @default(now())
  updatedAt   DateTime?     @updatedAt

   @@index([pushSentAt, nextPushAttemptAt])
   @@index([createdAt])
}

model PushNotification {
  sessionId String?
  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  endpoint  String? @unique
  id        String    @id @default(cuid())
  config    Json?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

   @@index([createdAt])
}

model Revenue {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") // Relates to the User
  amount    Decimal @db.Decimal(20, 2) // Revenue earned by the user
  source    String // Source of revenue (e.g., 'ads', 'content creation')
  isPaid    Boolean  @default(false) // Indicates if the payout has been made
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model TipPackage {
  id              String            @id @default(cuid())
  name            String
  price           Decimal @db.Decimal(20, 2)             // Amount in coins to send this tip
  kind            TipKindEnum       @default(ALL)
  thumbnail       String?
  isActive        Boolean           @default(true)
  endDate         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  transactions    Transaction[]
  transactionLogs TransactionLogs[]
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  postTips        PostTip[]
  @@index([createdAt])
}

model PostTip {
  id              String       @id @default(cuid())
  senderId        String
  sender          User         @relation("PostTipsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId     String
  recipient       User         @relation("PostTipsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  postId          String?
  post            Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  tipId           String
  tip             TipPackage   @relation(fields: [tipId], references: [id], onDelete: Cascade)
  rewardTip       RewardTip?   
  coinsAmount     Decimal? @db.Decimal(20, 2) // Immutable gross coin value; null for legacy tips
  message         String?
  isAnon          Boolean      @default(false)
  referer         String?
  meta            Json?
  device          Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@index([postId, createdAt(sort: Desc), id(sort: Desc)])
}

model RewardTip {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String
  wallet          Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  postTipId       String       @unique
  postTip         PostTip      @relation(fields: [postTipId], references: [id], onDelete: Cascade)
  txnId           String       @unique
  transaction     Transaction  @relation(fields: [txnId], references: [id])
  amount          Decimal @db.Decimal(20, 2)
  source          TipSource
  status          TipStatus    @default(PENDING)
  settledAt       DateTime?
  availableAt     DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([availableAt])
  @@index([settledAt])
}


model CoinPackage {
  id              String            @id @default(cuid())
  name            String
  amount          Decimal @db.Decimal(20, 2)
  price           Decimal @db.Decimal(20, 2)
  bonus           Decimal @db.Decimal(20, 2)
  ngnPrice        Decimal @db.Decimal(20, 2)             @default(0)
  ngnBonus        Decimal @db.Decimal(20, 2)             @default(0)
  isActive        Boolean           @default(true)
  endDate         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  transactions    Transaction[]
  transactionLogs TransactionLogs[]
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([createdAt])
}

model Wallet {
  id           String        @id @default(cuid())
  credit       Decimal @db.Decimal(20, 2)         @default(0) // Credit that can be withrawn by the user
  coins        Decimal @db.Decimal(20, 2)         @default(0) // Coins purchased by the user
  bonus        Decimal @db.Decimal(20, 2)         @default(0) // Interaction-based rewards
  userId       String        @unique @map("user_id")
  isLocked     Boolean?      @default(false)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  tips         RewardTip[]

  @@index([createdAt])
}

model Transaction {
  id             String            @id @default(cuid())
  txnRef         String
  exTxnRef       String?
  userId         String?           @map("user_id") // Relates to the User
  user           User?             @relation(fields: [userId], references: [id])
  senderId       String? // Nullable for system-initiated transactions
  sender         User?             @relation("Sender", fields: [senderId], references: [id])
  recipientId    String? // Nullable for transactions without a recipient (e.g., fee deductions)
  recipient      User?             @relation("Recipient", fields: [recipientId], references: [id])
  type           TxnTypeEnum
  amount         Decimal @db.Decimal(20, 2) // The amount involved in the transaction (coins, credits, etc.)
  source         TxnSourceEnum // Type of balance used (e.g., 'bonus', 'amount', 'credit', etc.)
  description    String
  category       TxnCategoryEnum // The category of the transaction (e.g., 'game-deduction', 'purchase', 'gift', 'subscription')
  metadata       Json? // Any other data for specific transactions (e.g., game round ID, item ID, content ID, etc.)
  gateway        TxnGatewayEnum
  currency       TxnCurrencyEnum
  status         TxnStatusEnum
  walletId       String?
  wallet         Wallet?           @relation(fields: [walletId], references: [id])
  coinPackageId  String?
  package        CoinPackage?      @relation(fields: [coinPackageId], references: [id])
  tipPackageId   String?
  tip            TipPackage?       @relation(fields: [tipPackageId], references: [id])
  rewardTip      RewardTip?       
  achievementId  String?           @unique
  achievement    GameAchievement?
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  subPlanId      String?
  subPlan        SubscriptionPlan? @relation(fields: [subPlanId], references: [id])
  taskId         String?
  task           Task?             @relation(fields: [taskId], references: [id])
  postId         String?
  post           Post?             @relation(fields: [postId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   @@index([createdAt])
}

model TransactionLogs {
  id            String       @id @default(cuid())
  userId        String?      @map("user_id")
  coinPackageId String?
  package       CoinPackage? @relation(fields: [coinPackageId], references: [id])
  tipPackageId  String?
  tipPackage    TipPackage?  @relation(fields: [tipPackageId], references: [id])
  meta          Json?
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([createdAt])
}

model UserTaskSettings {
  id             String   @id @default(cuid())
  dailyBonusDate DateTime @default(now())
  adsBonusDate   DateTime @default(now())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

   @@index([createdAt])
}

model Game {
  id          String         @id @default(cuid())
  name        String
  description String
  thumbnail   String?
  userId      String?        @map("user_id")
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories  GameCategory[]
  modes       GameMode[] // optional
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

   @@index([createdAt])
}


model QuizQuestion {
  id             String       @id @default(cuid())
  categoryId     String
  category       GameCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question       String
  answer         String
  options        String[]
  normalizedHash String
  createdAt      DateTime     @default(now())

  @@unique([categoryId, normalizedHash])
  @@index([categoryId, id])
}

model GameCategory {
  questions            QuizQuestion[]
  id                   String                @id @default(cuid())
  name                 String
  description          String
  thumbnail            String?
  gameId               String
  game                 Game                  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId               String?               @map("user_id")
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics               String[]              @default([])
  rooms                GameRoom[]
  gameYearStats        GameYearStat[]
  gameMonthStats       GameMonthStat[]
  gameEnergy           GameEnergy[]
  gameAchievements     GameAchievement[]
  gameMonthRewardStats GameMonthRewardStat[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model GameRoom {
  id          String       @id @default(cuid())
  name        String
  description String
  thumbnail   String?
  capacity    Int          @default(20)
  userId      String?      @map("user_id")
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  catId       String       @map("cat_id")
  category    GameCategory @relation(fields: [catId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model GameMonthStat {
  id        String       @id @default(cuid())
  mode      GameMode
  catId     String
  category  GameCategory @relation(fields: [catId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  playerId  String
  player    User         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rank      Int          @default(0)
  score     Int          @default(0)
  numPlayed Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  gameAchievements GameAchievement[]

  @@unique([playerId, catId, year, month, mode]) // Unique entry for each player in a category for a given month
  @@index([catId, year, month, mode]) // Index for queries by category and time period
}

model GameYearStat {
  id               String            @id @default(cuid())
  mode             GameMode
  catId            String
  category         GameCategory      @relation(fields: [catId], references: [id], onDelete: Cascade)
  year             Int
  playerId         String
  player           User              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rank             Int               @default(0)
  score            Int               @default(0)
  numPlayed        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  gameAchievements GameAchievement[]

  @@unique([playerId, catId, year, mode]) // Unique entry for each player in a category for a given year
  @@index([catId, year, mode]) // Index for queries by category and year
}

model GameMonthRewardStat {
  id                       String       @id @default(cuid())
  totalParticipants        Float // Total participants under the game category
  rewardParticipants       Float // No of participants rewarded under the game category
  coinsRewardParticipants  Float // No of participants rewarded coins under the game category 
  creditRewardParticipants Float // No of participants rewarded credit under the game category
  bonusRewardParticipants  Float // No of participants rewarded bonus under the game category
  creditParticipantsScore  Float // Total score by the credit participants
  coinsParticipantsScore   Float // Total score by the coins participants
  bonusParticipantsScore   Float // Total score by the bonus participants
  numPlayed                Float // Number of times played
  coinsSpent               Decimal @db.Decimal(20, 2) // Amount of coins spent in the game
  bonusSpent               Decimal @db.Decimal(20, 2) // Amount of bonus spent in the game
  creditShareAmount        Decimal @db.Decimal(20, 2) // Amount of credit shared to the credit reward participant
  coinsShareAmount         Decimal @db.Decimal(20, 2) // Amount of coins shared to the coins reward participant
  bonusShareAmount         Decimal @db.Decimal(20, 2) // Amount of credit shared to the bonus reward participant
  rewardParticipantsScore  Float // Total score of rewarded participants
  totalScore               Float // Total score of the participants under the game category
  year                     Int // Year of the game category
  month                    Int // Month of the game category
  catId                    String
  category                 GameCategory @relation(fields: [catId], references: [id], onDelete: Cascade)
  mode                     GameMode
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

model GameMilestone {
  id           String            @id @default(cuid())
  name         MilestoneNameEnum
  reason       RewardReasonEnum
  thumbnail    String?
  milestone    Int
  reward       Int
  rewardType   RewardTypeEnum
  userId       String?           @map("user_id")
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements GameAchievement[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model GameAchievement {
  id          String           @id @default(cuid())
  reason      RewardReasonEnum
  description String
  thumbnail   String?
  metadata    Json?
  amount      Decimal @db.Decimal(20, 2)
  rewardType  RewardTypeEnum
  mode        GameMode?
  txnId       String?          @unique
  transaction Transaction?     @relation(fields: [txnId], references: [id], onDelete: Cascade)
  catId       String?
  category    GameCategory?    @relation(fields: [catId], references: [id], onDelete: Cascade)
  playerId    String
  player      User             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  monthStatId String?          @map("month_stat_id") // Link to monthly stat
  monthStat   GameMonthStat?   @relation(fields: [monthStatId], references: [id])
  yearStatId  String?          @map("year_stat_id") // Link to yearly stat
  yearStat    GameYearStat?    @relation(fields: [yearStatId], references: [id])
  milestoneId String?
  milestone   GameMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  // @@unique([playerId, milestoneId, catId]) // Ensure uniqueness per category for each player and milestone
}

model GameEnergy {
  id        String        @id @default(cuid())
  amount    Int
  gauge     Int
  turbo     Int
  playerId  String
  player    User          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  catId     String        @map("cat_id")
  category  GameCategory? @relation(fields: [catId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Task {
  id           String         @id @default(cuid())
  reward       Decimal @db.Decimal(20, 2)
  rewardType   RewardTypeEnum
  title        String
  description  String
  url          String
  code         String?
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  performedBy  UserTask[]
  transactions Transaction[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model UserTask {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status    TaskStatus @default(COMPLETED) // Track task performance status
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// this will define app crypto addresses to receive transactions
model CryptoAddress {
  id        String     @id @default(cuid())
  name      CryptoName
  rate      Float
  address   String
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Historical records only; no generated client or active integration.
  @@ignore
}

// this will save users crypto addresses
model WalletAddress {
  id        String     @id @default(cuid())
  name      CryptoName
  address   String
  isPrimary Boolean    @default(false)
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata  Json[]     @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Historical records only; no generated client or active integration.
  @@ignore
}

// this model handles referral
model Referral {
  id           String   @id @default(cuid())
  referrerId   String // The referring user
  refereeId    String // The referred user
  isRewarded   Boolean  @default(false) // issued for this referral
  referrer     User     @relation("ReferralsSent", fields: [referrerId], references: [id], onDelete: Cascade)
  referee      User     @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  amount       Decimal @db.Decimal(20, 2)    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([referrerId, refereeId]) // Enforce unique referrals
}

