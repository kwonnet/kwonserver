{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node -r ./scripts/register-paths.cjs dist/index.js",
    "nodemon": "nodemon",
    "dev": "TS_NODE=true NODE_NO_WARNINGS=1 ts-node -r tsconfig-paths/register src/index.ts",
    "build": "npm run db:generate && npm run compile && npm run build:seed",
    "compile": "tsc -p tsconfig.build.json",
    "deploy-app": "gcloud app deploy app.yaml",
    "deploy": "gcloud app deploy app.flexible.yaml",
    "gcp-build": "npm run build",
    "test": "npm run test:unit && npm run test:regression",
    "test:integrations": "node --test tests/retired-integrations.test.cjs",
    "build:seed": "tsc -p tsconfig.seed.json",
    "db:generate": "prisma generate",
    "db:migrate": "npm run db:generate && npm run build:seed && prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:demo": "npm run build:seed && prisma db seed -- --demo",
    "db:deploy": "npm run db:migrate:deploy && npm run db:seed",
    "db:setup": "npm run build && npm run db:deploy",
    "test:prisma": "node --test tests/prisma-seed.test.cjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:regression": "node --test tests/*.test.cjs",
    "test:typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:integration": "node scripts/test-infrastructure.cjs tests/integration",
    "test:e2e": "node scripts/test-infrastructure.cjs tests/e2e",
    "test:infrastructure": "node scripts/test-infrastructure.cjs",
    "test:all": "npm run test:typecheck && npm run test:unit:coverage && npm run test:regression && npm run test:infrastructure"
  },
  "prisma": {
    "seed": "node dist-seed/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
