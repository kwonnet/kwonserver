{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node -r ./scripts/register-paths.cjs dist/index.js",
    "nodemon": "TS_NODE=true NODE_NO_WARNINGS=1 node --watch -r ts-node/register -r tsconfig-paths/register src/index.ts",
    "dev": "TS_NODE=true NODE_NO_WARNINGS=1 ts-node -r tsconfig-paths/register src/index.ts",
    "build": "npm run db:generate && npm run compile && npm run build:seed",
    "compile": "tsc -p tsconfig.build.json",
    "deploy-app": "gcloud app deploy app.yaml",
    "deploy": "gcloud app deploy app.flexible.yaml",
    "gcp-build": "npm run build",
    "test": "npm run test:unit && npm run test:regression",
    "test:integrations": "node --test tests/retired-integrations.test.cjs",
    "build:seed": "tsc -p tsconfig.seed.json",
    "db:generate": "prisma generate",
    "db:migrate": "npm run db:generate && npm run build:seed && prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:demo": "npm run build:seed && prisma db seed -- --demo",
    "db:deploy": "node scripts/database-analytics.cjs deploy",
    "db:setup": "npm run build && npm run db:deploy",
    "test:prisma": "node --test tests/prisma-seed.test.cjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:regression": "node --test tests/*.test.cjs",
    "test:typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:integration": "node scripts/test-infrastructure.cjs tests/integration",
    "test:e2e": "node scripts/test-infrastructure.cjs tests/e2e",
    "test:infrastructure": "node scripts/test-infrastructure.cjs",
    "test:all": "npm run test:typecheck && npm run test:unit:coverage && npm run test:regression && npm run test:infrastructure",
    "db:seed:topics": "prisma db seed -- --game-topics",
    "start:worker": "node -r ./scripts/register-paths.cjs dist/cron/worker.js",
    "dev:worker": "ts-node -r tsconfig-paths/register src/cron/worker.ts",
    "quiz:inventory": "node -r ./scripts/register-paths.cjs dist/services/questionInventory/cli.js",
    "redis:connections": "node scripts/redis-connections.cjs",
    "wallet:audit": "node scripts/wallet-audit.cjs",
    "db:extensions": "node scripts/database-analytics.cjs extensions",
    "db:analytics": "node scripts/database-analytics.cjs setup",
    "auth:cleanup": "node scripts/auth-retention.cjs",
    "topics:evaluate": "node scripts/evaluate-post-topics.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mjml": "5.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/stopword": "^2.0.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "prisma-json-types-generator": "5.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@clickhouse/client": "1.24.0",
    "@faker-js/faker": "10.6.0",
    "@google/genai": "2.27.0",
    "@huggingface/transformers": "4.3.1",
    "@keyv/redis": "^5.1.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supercharge/promise-pool": "3.3.0",
    "@types/crypto-js": "^4.2.2",
    "axios": "1.20.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.3.11",
    "cache-manager": "7.2.9",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "crypto-js": "^4.2.0",
    "dayjs": "1.11.23",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "google-auth-library": "11.1.0",
    "helmet": "8.3.0",
    "imagekit": "^6.0.0",
    "ioredis": "6.0.0",
    "ip-location-api": "5.0.2",
    "jsonwebtoken": "9.0.3",
    "mjml": "5.4.1",
    "nanoid": "6.0.2",
    "node-device-detector": "2.2.7",
    "node-rake-v2": "^0.0.3",
    "nodemailer": "10.0.15",
    "openai": "7.30.0",
    "pg": "8.23.1",
    "pg-hstore": "^2.3.4",
    "pgvector": "0.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "random-words": "^2.0.1",
    "redis": "6.3.0",
    "sequelize": "6.37.8",
    "socket.io": "4.8.4",
    "stopword": "^3.1.5",
    "ts-express-sse": "^1.0.3",
    "tsconfig-paths": "^4.2.0",
    "uuid": "14.0.2",
    "web-push": "^3.6.7",
    "wordlist-english": "^1.2.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "overrides": {
    "uuid@<11.1.1": "11.1.1",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
