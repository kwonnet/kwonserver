# Database release: optional direct/session URL if DATABASE_URL uses a transaction pooler.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# auto enables TimescaleDB when available; required fails if missing; off skips enabling it.
TIMESCALEDB_MODE=auto

# Must match kwonweb R2 public media base URL (profile image ownership validation).
CLOUDFLARE_PUBLIC_MEDIA_URL="https://media.kwonnet.com"

# Google OAuth client ID; must match kwonweb AUTH_GOOGLE_ID.
AUTH_GOOGLE_ID=

# Auth metadata bridge: use the same independent random secret (>=32 chars) in kwonweb.
AUTH_TELEMETRY_SHARED_SECRET=
# Optional independent >=32-character secret for keyed IP correlation; never sent to clients.
AUTH_IP_HASH_SECRET=
# Comma-separated trusted proxy CIDRs/names. Default: loopback,uniquelocal.
# Narrow this to the actual Caddy/container/LB addresses in production; never use true/0.0.0.0/0.
AUTH_TRUST_PROXY_IPS=

# Transactional welcome email (configure in KWONSERVER_ENV for deployment)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WEB_APP_URL=https://kwonnet.com

# Shared by API and email worker. Generate a random secret of at least 32 characters.
AUTH_EMAIL_TOKEN_SECRET=
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
# Public HTTPS logo URL used by MJML emails. Set this to your hosted logo.
APP_LOGO=
